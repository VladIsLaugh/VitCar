{
  "name": "vitauto",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint --filter=*",
    "type-check": "turbo run type-check --filter=*",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "db:migrate": "pnpm --filter=@vitauto/api db:migrate",
    "db:studio": "pnpm --filter=@vitauto/api db:studio",
    "db:generate": "pnpm --filter=@vitauto/api db:generate",
    "db:reset": "pnpm --filter=@vitauto/api db:reset",
    "db:seed": "pnpm --filter=@vitauto/api db:seed"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
