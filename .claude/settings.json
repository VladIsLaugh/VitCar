{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(docker-compose *)",
      "Bash(docker *)",
      "Bash(npx prisma *)",
      "Bash(railway *)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(node *)",
      "Bash(tsx *)",
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(touch *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(npx prisma migrate reset)",
      "Bash(npx prisma db push --force-reset)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-i18n-parity.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-database.sh"
          }
        ]
      }
    ]
  }
}
