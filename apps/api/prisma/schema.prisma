generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  MANAGER
  ADMIN
}

enum AuctionCondition {
  RUN_AND_DRIVE
  ENGINE_START
  STATIONARY
  ENHANCED_VEHICLE
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum AuctionSource {
  COPART
  IAAI
}

enum SaleStatus {
  SOLD
  UNSOLD
}

enum MileageUnit {
  MILES
  KM
}

model Make {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  models Model[]
  lots   Lot[]
}

model Model {
  id     String @id @default(cuid())
  makeId String
  make   Make   @relation(fields: [makeId], references: [id])
  name   String
  slug   String
  lots   Lot[]

  @@unique([makeId, slug])
}

model Lot {
  id          String        @id @default(cuid())
  source      AuctionSource
  lotNumber   String
  vin         String?
  makeId      String
  make        Make          @relation(fields: [makeId], references: [id])
  modelId     String
  model       Model         @relation(fields: [modelId], references: [id])
  year        Int
  bodyType    String?
  fuelType    FuelType?
  engineCC    Int?
  mileage     Int?
  mileageUnit MileageUnit   @default(MILES)
  damageType  String?
  titleStatus String?
  saleStatus  SaleStatus    @default(SOLD)
  finalBid    Float?
  currency    String        @default("USD")
  saleDate    DateTime?
  location    String?
  state       String?
  photoUrls   String[]
  externalUrl String?
  scrapedAt   DateTime      @default(now())

  @@unique([lotNumber, source])
  @@index([makeId, modelId, year])
  @@index([saleDate])
  @@index([finalBid])
  @@index([state])
  @@index([saleStatus])
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String?
  googleId            String?   @unique
  firstName           String?
  lastName            String?
  avatarUrl           String?
  role                Role      @default(CLIENT)
  isVerified          Boolean   @default(false)
  isActive            Boolean   @default(true)
  blockedReason       String?
  blockedById         String?
  onboardingCompleted Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  calculations            Calculation[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Calculation {
  id               String    @id @default(cuid())
  userId           String?
  user             User?     @relation(fields: [userId], references: [id])
  shareToken       String    @unique @default(cuid())
  inputParams      Json
  result           Json
  settingsSnapshot Json
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
}

model CalculationSettings {
  id            String    @id @default(cuid())
  category      String
  key           String
  data          Json
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@unique([category, key, effectiveFrom])
}
